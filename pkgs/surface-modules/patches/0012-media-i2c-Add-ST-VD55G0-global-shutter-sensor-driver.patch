+#define vd55g0_read(sensor, reg, val, err) \
+	cci_read((sensor)->regmap, reg, val, err)
+
+#define vd55g0_write(sensor, reg, val, err) \
+	cci_write((sensor)->regmap, reg, val, err)
+
+static int get_chunk_size(struct vd55g0_dev *sensor)
+{
+	int max_write_len = VD55G0_WRITE_MULTIPLE_CHUNK_MAX;
+	struct i2c_adapter *adapter = sensor->i2c_client->adapter;
+
+	if (adapter->quirks && adapter->quirks->max_write_len)
+		max_write_len = adapter->quirks->max_write_len - 2;
+
+	max_write_len = min(max_write_len, VD55G0_WRITE_MULTIPLE_CHUNK_MAX);
+
+	return max(max_write_len, 1);
+}
+
+static int vd55g0_write_array(struct vd55g0_dev *sensor, u32 reg,
+			      unsigned int nb, const u8 *array)
+{
+	const unsigned int chunk_size = get_chunk_size(sensor);
+	unsigned int addr = CCI_REG_ADDR(reg);
+	unsigned int sz;
+	int ret;
+
+	while (nb) {
+		sz = min(nb, chunk_size);
+		ret = regmap_bulk_write(sensor->regmap, addr, array, sz);
+		if (ret < 0)
+			return ret;
+		nb -= sz;
+		addr += sz;
+		array += sz;
+	}
+
+	return 0;
+}
+
+static int vd55g0_poll_reg(struct vd55g0_dev *sensor, u32 reg, u8 poll_val,
+			   unsigned int timeout_ms)
+{
+	unsigned int val = 0;
+
+	return regmap_read_poll_timeout(sensor->regmap, CCI_REG_ADDR(reg), val,
+					(val == poll_val), 10 * USEC_PER_MSEC,
+					timeout_ms * USEC_PER_MSEC);
+}
+
+static int vd55g0_wait_state(struct vd55g0_dev *sensor, int state,
+			     unsigned int timeout_ms)
+{
+	return vd55g0_poll_reg(sensor, VD55G0_REG_SYSTEM_FSM, state,
+			       timeout_ms);
+}
+
+static int vd55g0_prepare_clock_tree(struct vd55g0_dev *sensor)
+{
+	struct device *dev = &sensor->i2c_client->dev;
+	u32 pixel_div;
+
+	if (sensor->clk_freq < VD55G0_XCLK_FREQ_MIN ||
+	    sensor->clk_freq > VD55G0_XCLK_FREQ_MAX) {
+		dev_err(dev,
+			"Only %luMHz-%luMHz clock range supported. Provided %lu MHz\n",
+			VD55G0_XCLK_FREQ_MIN / HZ_PER_MHZ,
+			VD55G0_XCLK_FREQ_MAX / HZ_PER_MHZ,
+			sensor->clk_freq / HZ_PER_MHZ);
+		return -EINVAL;
+	}
+
+	/*
+	 * The MIPI bus is double data rate, and its rate is an integer multiple
+	 * of the input clock. The sensor would round any other rate down
+	 * (UM2829 13.6), so it is refused rather than used.
+	 */
+	if (sensor->link_freq < VD55G0_MIPI_RATE_MIN / 2 ||
+	    sensor->link_freq > VD55G0_MIPI_RATE_MAX / 2) {
+		dev_err(dev,
+			"Only %luMbps-%luMbps data rate range supported. Provided link frequency %llu Hz\n",
+			VD55G0_MIPI_RATE_MIN / MEGA, VD55G0_MIPI_RATE_MAX / MEGA,
+			sensor->link_freq);
+		return -EINVAL;
+	}
+	sensor->mipi_rate = sensor->link_freq * 2;
+	if (sensor->mipi_rate % sensor->clk_freq) {
+		dev_err(dev,
+			"Link frequency %llu Hz is not a multiple of half the %u Hz input clock\n",
+			sensor->link_freq, sensor->clk_freq);
+		return -EINVAL;
+	}
+
+	pixel_div = sensor->mipi_rate <= VD55G0_MIPI_RATE_FAST ? 6 : 8;
+	sensor->pixel_rate = sensor->mipi_rate / pixel_div;
+
+	return 0;
+}
