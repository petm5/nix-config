+static int vd55g0_update_gpio_mode(struct vd55g0_dev *sensor, u32 mode,
+				   int gpio)
+{
+	static const u8 index2val[] = {0x01, 0x02};
+
+	return vd55g0_write(sensor, VD55G0_REG_GPIO_0_CTRL + gpio,
+			    index2val[mode], NULL);
+}
