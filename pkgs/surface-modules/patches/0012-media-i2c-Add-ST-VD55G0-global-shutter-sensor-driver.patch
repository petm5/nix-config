+static int vd55g0_set_gpios_array(struct vd55g0_dev *sensor, u32 *array,
+				  int size, enum vd55g0_gpio_modes mode)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < size;  i++) {
+		if (array[i] == ~0)
+			break;
+		ret = vd55g0_update_gpio_mode(sensor, mode, array[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int vd55g0_apply_exposure_auto(struct vd55g0_dev *sensor)
+{
+	enum vd55g0_expo_state exp = sensor->expo_state;
+
+	if (sensor->ae_frozen && sensor->expo_state == VD55G0_EXP_AUTO)
+		exp = VD55G0_EXP_FREEZE;
+
+	return vd55g0_write(sensor, VD55G0_REG_EXP_MODE, exp, NULL);
+}
+
+static int vd55g0_get_regulators(struct vd55g0_dev *sensor)
+{
+	struct device *dev = &sensor->i2c_client->dev;
+	const char * const *names;
+	unsigned int i;
+
+	/* A PRP0001 device has DT names; only the ACPI ID has INT3472's */
+	if (acpi_match_device(vd55g0_acpi_ids, dev)) {
+		names = vd55g0_acpi_supply_name;
+		sensor->nb_supplies = ARRAY_SIZE(vd55g0_acpi_supply_name);
+	} else {
+		names = vd55g0_dt_supply_name;
+		sensor->nb_supplies = ARRAY_SIZE(vd55g0_dt_supply_name);
+	}
+
+	for (i = 0; i < sensor->nb_supplies; i++)
+		sensor->supplies[i].supply = names[i];
+
+	return devm_regulator_bulk_get(dev, sensor->nb_supplies,
+				       sensor->supplies);
+}
+
+static int vd55g0_apply_patgen(struct vd55g0_dev *sensor)
+{
+	static const u8 index2val[] = {
+		0x0, 0x0, 0x8, 0x10, 0x20, 0x21, 0x22, 0x28
+	};
+	u32 pattern = index2val[sensor->pattern];
+	u32 reg = pattern << VD55G0_PATGEN_TYPE_SHIFT;
+	u8 darkcal = VD55G0_DARKCAL_AUTO;
+	u8 duster = VD55G0_DUSTER_RING_ENABLE | VD55G0_DUSTER_DYN_ENABLE |
+		    VD55G0_DUSTER_ENABLE;
+	int ret = 0;
+
+	if (sensor->pattern != 0) {
+		reg |= VD55G0_PATGEN_ENABLE;
+		/*
+		 * Take care of dark calibaration and duster to not mess up the
+		 * test pattern output.
+		 */
+		darkcal = VD55G0_DARKCAL_BYPASS;
+		duster = VD55G0_DUSTER_DISABLE;
+	}
+
+	vd55g0_write(sensor, VD55G0_REG_DARKCAL_CTRL, darkcal, &ret);
+	vd55g0_write(sensor, VD55G0_REG_DUSTER_CTRL, duster, &ret);
+	if (ret)
+		return ret;
+
+	return vd55g0_write(sensor, VD55G0_REG_PATGEN_CTRL, reg, NULL);
+}
+
+static int vd55g0_apply_flash(struct vd55g0_dev *sensor)
+{
+	enum vd55g0_gpio_modes mode = sensor->flash_en ?
+				      VD55G0_GPIO_MODE_STROBE :
+				      VD55G0_GPIO_MODE_DISABLED;
+
+	return vd55g0_set_gpios_array(sensor, sensor->leds,
+				      ARRAY_SIZE(sensor->leds), mode);
+}
+
+/* The helpers below cache a value only once the sensor has taken it */
+static int vd55g0_update_exposure_auto(struct vd55g0_dev *sensor, u32 index)
+{
+	enum vd55g0_expo_state old = sensor->expo_state;
+	int ret;
+
+	switch (index) {
+	case V4L2_EXPOSURE_AUTO:
+		sensor->expo_state = VD55G0_EXP_AUTO;
+		break;
+	case V4L2_EXPOSURE_MANUAL:
+		sensor->expo_state = VD55G0_EXP_MANUAL;
+		break;
+	default:
+		/* Should never happen */
+		return -EINVAL;
+	}
+
+	if (!sensor->streaming)
+		return 0;
+
+	ret = vd55g0_apply_exposure_auto(sensor);
+	if (ret)
+		sensor->expo_state = old;
+
+	return ret;
+}
+
+static int vd55g0_lock_exposure(struct vd55g0_dev *sensor,
+				struct v4l2_ctrl *ctrl)
+{
+	/* Only exposure lock is supported */
+	bool ae_lock = ctrl->val & V4L2_LOCK_EXPOSURE;
+	bool old = sensor->ae_frozen;
+	int ret;
+
+	sensor->ae_frozen = ae_lock;
+
+	/* Cap control value to reflect the hardware state */
+	ctrl->val = ae_lock;
+
+	if (!sensor->streaming)
+		return 0;
+
+	ret = vd55g0_apply_exposure_auto(sensor);
+	if (ret)
+		sensor->ae_frozen = old;
+
+	return ret;
+}
+
+static int vd55g0_apply_framelength(struct vd55g0_dev *sensor)
+{
+	return vd55g0_write(sensor, VD55G0_REG_FRAME_LENGTH,
+			    sensor->frame_length, NULL);
+}
+
+static int vd55g0_update_vblank(struct vd55g0_dev *sensor, u16 vblank)
+{
+	u16 old_vblank = sensor->vblank, old_frame_length = sensor->frame_length;
+	int ret;
+
+	sensor->vblank_min = VD55G0_MIN_FRAME_LENGTH -
+			     sensor->current_mode->crop.height;
+	sensor->vblank = vblank;
+	sensor->frame_length = sensor->current_mode->crop.height +
+			       sensor->vblank;
+
+	if (!sensor->streaming)
+		return 0;
+
+	ret = vd55g0_apply_framelength(sensor);
+	if (ret) {
+		sensor->vblank = old_vblank;
+		sensor->frame_length = old_frame_length;
+	}
+
+	return ret;
+}
+
+static int vd55g0_update_analog_gain(struct vd55g0_dev *sensor, u32 target)
+{
+	int ret = 0;
+
+	if (sensor->streaming)
+		ret = vd55g0_write(sensor, VD55G0_REG_MANUAL_ANALOG_GAIN,
+				   target, NULL);
+	if (!ret)
+		sensor->analog_gain = target;
+
+	return ret;
+}
+
+static int vd55g0_update_digital_gain(struct vd55g0_dev *sensor, u32 target)
+{
+	int ret = 0;
+
+	if (sensor->streaming)
+		ret = vd55g0_write(sensor, VD55G0_REG_MANUAL_DIGITAL_GAIN,
+				   target, NULL);
+	if (!ret)
+		sensor->digital_gain = target;
+
+	return ret;
+}
+
+static int vd55g0_update_exposure(struct vd55g0_dev *sensor, int expo_ms)
+{
+	int ret = 0;
+
+	if (sensor->streaming)
+		ret = vd55g0_write(sensor, VD55G0_REG_MANUAL_COARSE_EXPOSURE,
+				   expo_ms, NULL);
+	if (!ret)
+		sensor->manual_expo = expo_ms;
+
+	return ret;
+}
+
+static int vd55g0_update_exposure_target(struct vd55g0_dev *sensor, int index)
+{
+	/*
+	 * Find auto exposure target with: default target exposure * 2^EV,
+	 * the default being VD55G0_EXPO_TARGET_DEF at index 6.
+	 */
+	static const unsigned int index2exposure_target[] = {
+		3, 5, 7, 10, 14, 19, 27, 38, 54, 76, 108, 153, 216,
+	};
+	unsigned int target = index2exposure_target[index];
+	int ret = 0;
+
+	if (sensor->streaming)
+		ret = vd55g0_write(sensor, VD55G0_REG_AE_TARGET_PERCENTAGE,
+				   target, NULL);
+	if (!ret)
+		sensor->exposure_target = target;
+
+	return ret;
+}
+
+static int vd55g0_update_flash(struct vd55g0_dev *sensor, int flash_en)
+{
+	bool old = sensor->flash_en;
+	int ret;
+
+	sensor->flash_en = flash_en;
+	if (!sensor->streaming)
+		return 0;
+
+	ret = vd55g0_apply_flash(sensor);
+	if (ret)
+		sensor->flash_en = old;
+
+	return ret;
+}
+
+static void vd55g0_apply_reset(struct vd55g0_dev *sensor)
+{
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	usleep_range(5000, 10000);
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	usleep_range(5000, 10000);
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	usleep_range(5000, 10000);
+}
+
+static void vd55g0_fill_framefmt(struct vd55g0_dev *sensor,
+				 const struct vd55g0_mode_info *mode,
+				 struct v4l2_mbus_framefmt *fmt, u32 code)
+{
+	fmt->code = code;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int vd55g0_try_fmt_internal(struct v4l2_subdev *sd,
+				   struct v4l2_mbus_framefmt *fmt,
+				   const struct vd55g0_mode_info **new_mode)
+{
+	struct vd55g0_dev *sensor = to_vd55g0_dev(sd);
+	const struct vd55g0_mode_info *mode = vd55g0_mode_data;
+	unsigned int index;
+
+	for (index = 0; index < ARRAY_SIZE(vd55g0_supported_codes); index++) {
+		if (vd55g0_supported_codes[index].code == fmt->code)
+			break;
+	}
+	if (index == ARRAY_SIZE(vd55g0_supported_codes))
+		index = 0;
+
+	mode = v4l2_find_nearest_size(vd55g0_mode_data,
+				      ARRAY_SIZE(vd55g0_mode_data), width,
+				      height, fmt->width, fmt->height);
+	if (new_mode)
+		*new_mode = mode;
+
+	vd55g0_fill_framefmt(sensor, mode, fmt,
+			     vd55g0_supported_codes[index].code);
+
+	return 0;
+}
+
+static int vd55g0_apply_cold_start(struct vd55g0_dev *sensor)
+{
+	int ret = 0;
+
+	vd55g0_write(sensor, VD55G0_REG_AE_COLDSTART_COARSE_EXPOSURE,
+		     sensor->cold_start.expo, &ret);
+	vd55g0_write(sensor, VD55G0_REG_AE_COLDSTART_ANALOG_GAIN,
+		     sensor->cold_start.analog_gain, &ret);
+	vd55g0_write(sensor, VD55G0_REG_AE_COLDSTART_DIGITAL_GAIN,
+		     sensor->cold_start.digital_gain, &ret);
+
+	return ret;
+}
+
+static int vd55g0_apply_settings(struct vd55g0_dev *sensor)
+{
+	int ret;
+
+	ret = vd55g0_apply_framelength(sensor);
+	if (ret)
+		return ret;
+
+	ret = vd55g0_apply_exposure_auto(sensor);
+	if (ret)
+		return ret;
+
+	vd55g0_write(sensor, VD55G0_REG_MANUAL_COARSE_EXPOSURE,
+		     sensor->manual_expo, &ret);
+	vd55g0_write(sensor, VD55G0_REG_MANUAL_ANALOG_GAIN,
+		     sensor->analog_gain, &ret);
+	vd55g0_write(sensor, VD55G0_REG_MANUAL_DIGITAL_GAIN,
+		     sensor->digital_gain, &ret);
+	vd55g0_write(sensor, VD55G0_REG_AE_TARGET_PERCENTAGE,
+		     sensor->exposure_target, &ret);
+	if (ret)
+		return ret;
+
+	ret = vd55g0_apply_cold_start(sensor);
+	if (ret)
+		return ret;
+
+	vd55g0_write(sensor, VD55G0_REG_ORIENTATION,
+		     sensor->hflip | (sensor->vflip << 1), &ret);
+	if (ret)
+		return ret;
+
+	ret = vd55g0_apply_patgen(sensor);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static int vd55g0_apply_frame_format(struct vd55g0_dev *sensor)
+{
+	const struct v4l2_rect *crop = &sensor->current_mode->crop;
+	int ret = 0;
+
+	vd55g0_write(sensor, VD55G0_REG_READOUT_CTRL,
+		     sensor->current_mode->bin_mode, &ret);
+	vd55g0_write(sensor, VD55G0_REG_ROI_X_START, crop->left, &ret);
+	vd55g0_write(sensor, VD55G0_REG_ROI_X_END,
+		     crop->left + crop->width - 1, &ret);
+	vd55g0_write(sensor, VD55G0_REG_ROI_Y_START, crop->top, &ret);
+	vd55g0_write(sensor, VD55G0_REG_ROI_Y_END,
+		     crop->top + crop->height - 1, &ret);
+
+	/*
+	 * Use the same auto exposure crop as the image crop, performing auto
+	 * exposure computation only on image boundaries.
+	 */
+	vd55g0_write(sensor, VD55G0_REG_AE_ROI_START_H, crop->left, &ret);
+	vd55g0_write(sensor, VD55G0_REG_AE_ROI_END_H,
+		     crop->left + crop->width - 1, &ret);
+	vd55g0_write(sensor, VD55G0_REG_AE_ROI_START_V, crop->top, &ret);
+	vd55g0_write(sensor, VD55G0_REG_AE_ROI_END_V,
+		     crop->top + crop->height - 1, &ret);
+
+	return ret;
+}
+
+static int vd55g0_set_gpios(struct vd55g0_dev *sensor)
+{
+	int ret;
+	unsigned int i;
+
+	/* GPIOs in input (disabled) by default */
+	for (i = 0; i < VD55G0_NB_GPIOS; i++) {
+		ret = vd55g0_update_gpio_mode(sensor,
+					      VD55G0_GPIO_MODE_DISABLED, i);
+		if (ret)
+			return ret;
+	}
+
+	ret = vd55g0_apply_flash(sensor);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static int vd55g0_stream_enable(struct vd55g0_dev *sensor)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(&client->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = vd55g0_set_gpios(sensor);
+	if (ret)
+		goto err_rpm_put;
+
+	vd55g0_write(sensor, VD55G0_REG_FORMAT_CTRL,
+		     get_bpp_by_code(sensor->code), &ret);
+	vd55g0_write(sensor, VD55G0_REG_OIF_IMG_CTRL,
+		     get_data_type_by_code(sensor->code), &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = vd55g0_apply_frame_format(sensor);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = vd55g0_apply_settings(sensor);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = vd55g0_write(sensor, VD55G0_REG_SW_STBY,
+			   VD55G0_SW_STBY_START_STREAM, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = vd55g0_poll_reg(sensor, VD55G0_REG_SW_STBY, 0, VD55G0_TIMEOUT_MS);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = vd55g0_wait_state(sensor, VD55G0_SYSTEM_FSM_STREAMING,
+				VD55G0_TIMEOUT_MS);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put(&client->dev);
+	return ret;
+}
+
+static void vd55g0_save_exposure(struct vd55g0_dev *sensor)
+{
+	u64 val;
+
+	/* On a read error, keep what the previous stream left */
+	if (!vd55g0_read(sensor, VD55G0_REG_APPLIED_COARSE_EXPOSURE, &val, NULL))
+		sensor->cold_start.expo = val;
+	if (!vd55g0_read(sensor, VD55G0_REG_APPLIED_DIGITAL_GAIN, &val, NULL))
+		sensor->cold_start.digital_gain = val;
+	if (!vd55g0_read(sensor, VD55G0_REG_APPLIED_ANALOG_GAIN, &val, NULL))
+		sensor->cold_start.analog_gain = val;
+}
+
+static void vd55g0_stream_disable(struct vd55g0_dev *sensor)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->sd);
+	int ret;
+
+	/* Keep exposure values for next cold start boot */
+	vd55g0_save_exposure(sensor);
+
+	ret = vd55g0_write(sensor, VD55G0_REG_STREAMING,
+			   VD55G0_STREAMING_STOP_STREAM, NULL);
+	if (ret)
+		goto err_str_dis;
+
+	ret = vd55g0_poll_reg(sensor, VD55G0_REG_STREAMING, 0, 2000);
+	if (ret)
+		goto err_str_dis;
+
+	ret = vd55g0_wait_state(sensor, VD55G0_SYSTEM_FSM_SW_STBY,
+				VD55G0_TIMEOUT_MS);
+
+err_str_dis:
+	if (ret)
+		dev_err(&client->dev, "failed to stop streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(&client->dev);
+}
+
+static int vd55g0_tx_from_ep(struct vd55g0_dev *sensor,
+			     struct fwnode_handle *handle)
+{
+	struct i2c_client *client = sensor->i2c_client;
+	struct v4l2_fwnode_endpoint *ep;
+	struct v4l2_fwnode_endpoint ep_node = { .bus_type =
+		V4L2_MBUS_CSI2_DPHY
+	};
+	int ret;
+
+	ep = &ep_node;
+	ret = v4l2_fwnode_endpoint_alloc_parse(handle, ep);
+	if (ret)
+		return ret;
+
+	/* The sensor has a single data lane */
+	if (ep->bus.mipi_csi2.num_data_lanes != 1) {
+		dev_err(&client->dev, "only one data lane is supported, found %u\n",
+			ep->bus.mipi_csi2.num_data_lanes);
+		goto error_ep;
+	}
+
+	if (ep->bus.mipi_csi2.clock_lane != 0) {
+		dev_err(&client->dev, "clock lane must be lane 0\n");
+		goto error_ep;
+	}
+
+	/* Only the two polarity bits: the rest of OIF_CTRL is reserved */
+	sensor->oif_ctrl = (ep->bus.mipi_csi2.lane_polarities[0] << 3) |
+			   (ep->bus.mipi_csi2.lane_polarities[1] << 6);
+
+	if (ep->nr_of_link_frequencies != 1) {
+		dev_err(&client->dev, "one link frequency is needed, found %u\n",
+			ep->nr_of_link_frequencies);
+		goto error_ep;
+	}
+	sensor->link_freq = ep->link_frequencies[0];
+
+	v4l2_fwnode_endpoint_free(ep);
+
+	return 0;
+
+error_ep:
+	v4l2_fwnode_endpoint_free(ep);
+
+	return -EINVAL;
+}
+
+static int vd55g0_patch(struct vd55g0_dev *sensor)
+{
+	struct i2c_client *client = sensor->i2c_client;
+	const struct vd55g0_patch *patch;
+	u64 patch_version;
+	int ret;
+
+	/* Choose appropriate patch for sensor revision */
+	if (sensor->revision == VD55G0_REVISION_CUT1)
+		patch = &vd55g0_patch_cut1;
+	else if (sensor->revision == VD55G0_REVISION_CUT2)
+		patch = &vd55g0_patch_cut2;
+	else
+		return -EINVAL;
+
+	/* Write patch */
+	ret = vd55g0_write_array(sensor, VD55G0_REG_FWPATCH_START_ADDR,
+				 patch->size, patch->bin);
+	if (ret)
+		return ret;
+
+	ret = vd55g0_write(sensor, VD55G0_REG_BOOT,
+			   VD55G0_BOOT_PATCH_SETUP, NULL);
+	if (ret)
+		return ret;
+
+	ret = vd55g0_poll_reg(sensor, VD55G0_REG_BOOT, 0, VD55G0_TIMEOUT_MS);
+	if (ret)
+		return ret;
+
+	/* Read back patch version */
+	ret = vd55g0_read(sensor, VD55G0_REG_FWPATCH_REVISION, &patch_version,
+			  NULL);
+	if (ret)
+		return ret;
+
+	if (patch_version != (patch->major << 8) + patch->minor) {
+		dev_err(&client->dev,
+			"bad patch version expected %d.%d got %llu.%llu\n",
+			patch->major, patch->minor,
+			patch_version >> 8, patch_version & 0xff);
+		return -ENODEV;
+	}
+	dev_dbg(&client->dev, "patch %llu.%llu applied\n",
+		patch_version >> 8, patch_version & 0xff);
+
+	return 0;
+}
+
+static int vd55g0_boot(struct vd55g0_dev *sensor)
+{
+	int ret;
+
+	ret = vd55g0_write(sensor, VD55G0_REG_BOOT, VD55G0_BOOT_BOOT, NULL);
+	if (ret)
+		return ret;
+
+	ret = vd55g0_poll_reg(sensor, VD55G0_REG_BOOT, 0, VD55G0_TIMEOUT_MS);
+	if (ret)
+		return ret;
+
+	ret = vd55g0_wait_state(sensor, VD55G0_SYSTEM_FSM_SW_STBY,
+				VD55G0_TIMEOUT_MS);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static int vd55g0_configure(struct vd55g0_dev *sensor)
+{
+	int ret = 0;
+
+	sensor->line_length = VD55G0_LINE_LENGTH_FAST;
+	if (sensor->mipi_rate <= VD55G0_MIPI_RATE_FAST)
+		sensor->line_length = VD55G0_LINE_LENGTH_SLOW;
+	vd55g0_write(sensor, VD55G0_REG_LINE_LENGTH, sensor->line_length,
+		     &ret);
+
+	/*
+	 * PLL_PREDIV and PLL_MULT are not accessible. We rely on the firmware
+	 * to set the correct multiplier for the clock. Hence we don't do
+	 * anything more here.
+	 */
+	vd55g0_write(sensor, VD55G0_REG_EXT_CLOCK, sensor->clk_freq, &ret);
+
+	vd55g0_write(sensor, VD55G0_REG_OIF_CTRL, sensor->oif_ctrl, &ret);
+	/* The status lines are not exposed, so do not send them, as vd55g1 */
+	vd55g0_write(sensor, VD55G0_REG_ISL_ENABLE, 0, &ret);
+	vd55g0_write(sensor, VD55G0_REG_CLK_PLL_MIPI, sensor->mipi_rate, &ret);
+
+	return ret;
+}
+
+/* Called with sensor->lock held, which is also the control handler's lock */
+static void vd55g0_grab_stream_ctrls(struct vd55g0_dev *sensor, bool grab)
+{
+	__v4l2_ctrl_grab(sensor->vflip_ctrl, grab);
+	__v4l2_ctrl_grab(sensor->hflip_ctrl, grab);
+	__v4l2_ctrl_grab(sensor->pattern_ctrl, grab);
+}
+
+static int vd55g0_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct vd55g0_dev *sensor = to_vd55g0_dev(sd);
+	int ret;
+
+	ret = vd55g0_stream_enable(sensor);
+	if (ret)
+		return ret;
+
+	sensor->streaming = true;
+	vd55g0_grab_stream_ctrls(sensor, true);
+
+	return 0;
+}
+
+static int vd55g0_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct vd55g0_dev *sensor = to_vd55g0_dev(sd);
+
+	/* Powered down either way, so report success as call_s_stream() does */
+	vd55g0_stream_disable(sensor);
+
+	sensor->streaming = false;
+	vd55g0_grab_stream_ctrls(sensor, false);
+
+	return 0;
+}
+
+static int vd55g0_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	const struct vd55g0_mode_info *mode;
+	const struct v4l2_mbus_framefmt *fmt;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		/* From the state asked about, so that TRY gets its own crop */
+		fmt = v4l2_subdev_state_get_format(sd_state, 0);
+		mode = v4l2_find_nearest_size(vd55g0_mode_data,
+					      ARRAY_SIZE(vd55g0_mode_data),
+					      width, height,
+					      fmt->width, fmt->height);
+		sel->r = mode->crop;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = VD55G0_WIDTH;
+		sel->r.height = VD55G0_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int vd55g0_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index >= ARRAY_SIZE(vd55g0_supported_codes))
+		return -EINVAL;
+
+	code->code = vd55g0_supported_codes[code->index].code;
+
+	return 0;
+}
+
+static int vd55g0_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *sd_state,
+			  struct v4l2_subdev_format *format)
+{
+	struct vd55g0_dev *sensor = to_vd55g0_dev(sd);
+	const struct vd55g0_mode_info *new_mode;
+	struct v4l2_mbus_framefmt *fmt;
+	unsigned int expo_max, hblank;
+	u16 vblank_def;
+	int ret;
+
+	/* The mode cannot change under a running stream */
+	if (format->which == V4L2_SUBDEV_FORMAT_ACTIVE && sensor->streaming)
+		return -EBUSY;
+
+	ret = vd55g0_try_fmt_internal(sd, &format->format, &new_mode);
+	if (ret)
+		return ret;
+
+	fmt = v4l2_subdev_state_get_format(sd_state, 0);
+	*fmt = format->format;
+
+	if (format->which != V4L2_SUBDEV_FORMAT_ACTIVE)
+		return 0;
+
+	if (sensor->current_mode == new_mode && sensor->code == fmt->code)
+		return 0;
+
+	sensor->code = fmt->code;
+	sensor->current_mode = new_mode;
+
+	/* Reset vblank and framelength to default */
+	vblank_def = VD55G0_FRAME_LENGTH_DEF - new_mode->crop.height;
+	ret = vd55g0_update_vblank(sensor, vblank_def);
+	if (ret)
+		return ret;
+
+	/* The range change may clamp and apply the old vblank; set the default */
+	ret = __v4l2_ctrl_modify_range(sensor->vblank_ctrl, sensor->vblank_min,
+				       0xffff - new_mode->crop.height, 1,
+				       vblank_def);
+	if (ret)
+		return ret;
+	ret = __v4l2_ctrl_s_ctrl(sensor->vblank_ctrl, vblank_def);
+	if (ret)
+		return ret;
+	/* Max exposure changes with vblank */
+	expo_max = sensor->frame_length - VD55G0_EXPO_MAX_TERM;
+	ret = __v4l2_ctrl_modify_range(sensor->expo_ctrl, 0, expo_max, 1,
+				       VD55G0_EXPO_DEF);
+	if (ret)
+		return ret;
+	/* Blanking counts from the analogue crop, as in vd55g1 */
+	hblank = sensor->line_length - sensor->current_mode->crop.width;
+	ret = __v4l2_ctrl_modify_range(sensor->hblank_ctrl, hblank, hblank, 1,
+				       hblank);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_s_ctrl(sensor->hblank_ctrl, hblank);
+}
+
+static int vd55g0_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	struct vd55g0_dev *sensor = to_vd55g0_dev(sd);
+	struct v4l2_subdev_format fmt = { 0 };
+
+	vd55g0_fill_framefmt(sensor, &vd55g0_mode_data[VD55G0_DEFAULT_MODE],
+			     &fmt.format, VD55G0_MEDIA_BUS_FMT_DEF);
+
+	return vd55g0_set_fmt(sd, sd_state, &fmt);
+}
+
+static int vd55g0_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	unsigned int i;
+
+	if (fse->index >= ARRAY_SIZE(vd55g0_mode_data))
+		return -EINVAL;
+
+	for (i = 0; i < ARRAY_SIZE(vd55g0_supported_codes); i++)
+		if (vd55g0_supported_codes[i].code == fse->code)
+			break;
+	if (i == ARRAY_SIZE(vd55g0_supported_codes))
+		return -EINVAL;
+
+	fse->min_width = vd55g0_mode_data[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = vd55g0_mode_data[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops vd55g0_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops vd55g0_pad_ops = {
+	.enum_mbus_code = vd55g0_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = vd55g0_set_fmt,
+	.enable_streams = vd55g0_enable_streams,
+	.disable_streams = vd55g0_disable_streams,
+	.get_selection = vd55g0_get_selection,
+	.enum_frame_size = vd55g0_enum_frame_size,
+};
+
+static const struct v4l2_subdev_ops vd55g0_subdev_ops = {
+	.video = &vd55g0_video_ops,
+	.pad = &vd55g0_pad_ops,
+};
+
+static const struct media_entity_operations vd55g0_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static const struct v4l2_subdev_internal_ops vd55g0_internal_ops = {
+	.init_state = vd55g0_init_state,
+};
+
+/*
+ * The manual values first, so that a switch to manual starts from them; the
+ * sensor ignores them under auto exposure.
+ */
+static int vd55g0_update_expo_cluster(struct vd55g0_dev *sensor)
+{
+	int ret = 0;
+
+	if (sensor->ae_ctrl->val == V4L2_EXPOSURE_MANUAL) {
+		/* A range change under auto exposure did not clamp it */
+		sensor->expo_ctrl->val = min(sensor->expo_ctrl->val,
+					     sensor->expo_ctrl->maximum);
+		if (sensor->expo_ctrl->is_new)
+			ret = vd55g0_update_exposure(sensor,
+						     sensor->expo_ctrl->val);
+		if (!ret && sensor->again_ctrl->is_new)
+			ret = vd55g0_update_analog_gain(sensor,
+							sensor->again_ctrl->val);
+		if (!ret && sensor->dgain_ctrl->is_new)
+			ret = vd55g0_update_digital_gain(sensor,
+							 sensor->dgain_ctrl->val);
+		if (ret)
+			return ret;
+	}
+
+	if (sensor->ae_ctrl->is_new)
+		ret = vd55g0_update_exposure_auto(sensor, sensor->ae_ctrl->val);
+
+	return ret;
+}
+
+/* Under auto exposure, the manual controls read what the sensor applies */
+static int vd55g0_g_volatile_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct vd55g0_dev *sensor = to_vd55g0_dev(ctrl_to_sd(ctrl));
+	struct device *dev = &sensor->i2c_client->dev;
+	u64 expo, again, dgain;
+	int ret = 0;
+
+	if (ctrl->id != V4L2_CID_EXPOSURE_AUTO)
+		return -EINVAL;
+
+	/* Only a powered sensor has applied values; keep the last ones */
+	if (!pm_runtime_get_if_in_use(dev))
+		return 0;
+
+	vd55g0_read(sensor, VD55G0_REG_APPLIED_COARSE_EXPOSURE, &expo, &ret);
+	vd55g0_read(sensor, VD55G0_REG_APPLIED_ANALOG_GAIN, &again, &ret);
+	vd55g0_read(sensor, VD55G0_REG_APPLIED_DIGITAL_GAIN, &dgain, &ret);
+	if (!ret) {
+		sensor->expo_ctrl->val = expo;
+		sensor->again_ctrl->val = again;
+		sensor->dgain_ctrl->val = dgain;
+	}
+
+	pm_runtime_put_autosuspend(dev);
+
+	return ret;
+}
+
+static int vd55g0_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct v4l2_subdev *sd = ctrl_to_sd(ctrl);
+	struct vd55g0_dev *sensor = to_vd55g0_dev(sd);
+	unsigned int expo_max;
+	u16 old_vblank;
+	int ret;
+
+	/* Read-only controls are set by the driver, there is nothing to apply */
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_VFLIP:
+	case V4L2_CID_HFLIP:
+		if (sensor->streaming) {
+			ret = -EBUSY;
+			break;
+		}
+		if (ctrl->id == V4L2_CID_VFLIP)
+			sensor->vflip = ctrl->val;
+		if (ctrl->id == V4L2_CID_HFLIP)
+			sensor->hflip = ctrl->val;
+		ret = 0;
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		/* Can't be done while streaming because of duster disabling */
+		sensor->pattern = ctrl->val;
+		ret = 0;
+		break;
+	case V4L2_CID_EXPOSURE_AUTO:
+		ret = vd55g0_update_expo_cluster(sensor);
+		break;
+	case V4L2_CID_3A_LOCK:
+		ret = vd55g0_lock_exposure(sensor, ctrl);
+		break;
+	case V4L2_CID_VBLANK:
+		old_vblank = sensor->vblank;
+		ret = vd55g0_update_vblank(sensor, ctrl->val);
+		if (ret)
+			break;
+		/* Max exposure changes with vblank */
+		expo_max = sensor->frame_length - VD55G0_EXPO_MAX_TERM;
+		ret = __v4l2_ctrl_modify_range(sensor->expo_ctrl, 0, expo_max,
+					       1, VD55G0_EXPO_DEF);
+		/* A clamped exposure failed to apply: put the frame back */
+		if (ret)
+			vd55g0_update_vblank(sensor, old_vblank);
+		break;
+	case V4L2_CID_AUTO_EXPOSURE_BIAS:
+		/*
+		 * We use auto exposure target percentage register to control
+		 * exposure bias for more precision.
+		 */
+		ret = vd55g0_update_exposure_target(sensor, ctrl->val);
+		break;
+	case V4L2_CID_FLASH_LED_MODE:
+		ret = vd55g0_update_flash(sensor, ctrl->val);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops vd55g0_ctrl_ops = {
+	.g_volatile_ctrl = vd55g0_g_volatile_ctrl,
+	.s_ctrl = vd55g0_s_ctrl,
+};
+
+static int vd55g0_init_controls(struct vd55g0_dev *sensor)
+{
+	const struct v4l2_ctrl_ops *ops = &vd55g0_ctrl_ops;
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrl_handler;
+	const struct vd55g0_mode_info *cur_mode = sensor->current_mode;
+	struct v4l2_fwnode_device_properties fwnode_props;
+	struct v4l2_ctrl *ctrl;
+	unsigned int patgen_size = ARRAY_SIZE(vd55g0_test_pattern_menu) - 1;
+	unsigned int hblank = sensor->line_length - cur_mode->crop.width;
+	unsigned int expo_mode = sensor->expo_state == VD55G0_EXP_AUTO ?
+		V4L2_EXPOSURE_AUTO :  V4L2_EXPOSURE_MANUAL;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 16);
+	/* we can use our own mutex for the ctrl lock */
+	hdl->lock = &sensor->lock;
+	v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_AUTO_EXPOSURE_BIAS,
+			       ARRAY_SIZE(vd55g0_ev_bias_menu) - 1,
+			       ARRAY_SIZE(vd55g0_ev_bias_menu) / 2,
+			       vd55g0_ev_bias_menu);
+	ctrl = v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ,
+				      0, 0, &sensor->link_freq);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE, sensor->pixel_rate,
+			  sensor->pixel_rate, 1, sensor->pixel_rate);
+	sensor->ae_ctrl = v4l2_ctrl_new_std_menu(hdl, ops,
+						 V4L2_CID_EXPOSURE_AUTO, 1,
+						 ~0x3, expo_mode);
+	sensor->again_ctrl = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN,
+					       0, 24, 1, sensor->analog_gain);
+	sensor->dgain_ctrl = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_DIGITAL_GAIN,
+					       256, 2048, 1,
+					       sensor->digital_gain);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_3A_LOCK, 0, 1, 0, 0);
+	/* Only when the firmware describes the LED GPIOs */
+	if (sensor->nb_leds)
+		v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_FLASH_LED_MODE,
+				       V4L2_FLASH_LED_MODE_FLASH, ~0x7,
+				       sensor->flash_en);
+
+	/*
+	 * Keep a pointer to these controls as we need to update them when
+	 * setting the format
+	 */
+	sensor->vblank_ctrl = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+						sensor->vblank_min,
+						0xffff - cur_mode->crop.height,
+						1, sensor->vblank);
+	sensor->hblank_ctrl = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+						hblank, hblank, 1, hblank);
+	if (sensor->hblank_ctrl)
+		sensor->hblank_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	sensor->vflip_ctrl = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+					       0, 1, 1, sensor->vflip);
+	sensor->hflip_ctrl = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HFLIP,
+					       0, 1, 1, sensor->hflip);
+	sensor->pattern_ctrl =
+		v4l2_ctrl_new_std_menu_items(hdl, ops, V4L2_CID_TEST_PATTERN,
+					     patgen_size, 0, 0,
+					     vd55g0_test_pattern_menu);
+	sensor->expo_ctrl =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 0,
+				  sensor->frame_length - VD55G0_EXPO_MAX_TERM,
+				  1, sensor->manual_expo);
+	if (!hdl->error)
+		v4l2_ctrl_auto_cluster(4, &sensor->ae_ctrl,
+				       V4L2_EXPOSURE_MANUAL, true);
+
+	ret = v4l2_fwnode_device_parse(&sensor->i2c_client->dev, &fwnode_props);
+	if (ret)
+		goto free_ctrls;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &fwnode_props);
+	if (ret)
+		goto free_ctrls;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto free_ctrls;
+	}
+
+	sensor->sd.ctrl_handler = hdl;
+	return 0;
+
+free_ctrls:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+static int vd55g0_detect(struct vd55g0_dev *sensor)
+{
+	struct i2c_client *client = sensor->i2c_client;
+	u64 revision, id = 0;
+	int ret;
+
+	ret = vd55g0_read(sensor, VD55G0_REG_MODEL_ID, &id, NULL);
+	if (ret)
+		return ret;
+
+	if (id != VD55G0_MODEL_ID) {
+		dev_warn(&client->dev, "Unsupported sensor id %llx\n", id);
+		return -ENODEV;
+	}
+
+	ret = vd55g0_read(sensor, VD55G0_REG_REVISION, &revision, NULL);
+	if (ret)
+		return ret;
+	dev_dbg(&client->dev, "Sensor revision 0x%llx\n", revision);
+
+	if (revision != VD55G0_REVISION_CUT1 &&
+	    revision != VD55G0_REVISION_CUT2) {
+		dev_err(&client->dev, "Unsupported device revision 0x%llx\n",
+			revision);
+		return -ENODEV;
+	}
+
+	sensor->revision = revision;
+
+	return 0;
+}
+
+/* Power/clock management functions */
+static int vd55g0_power_on(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct vd55g0_dev *sensor = to_vd55g0_dev(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(sensor->nb_supplies, sensor->supplies);
+	if (ret) {
+		dev_err(&client->dev, "failed to enable regulators %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(sensor->xclk);
+	if (ret) {
+		dev_err(&client->dev, "failed to enable clock %d\n", ret);
+		goto disable_bulk;
+	}
+
+	if (sensor->reset_gpio)
+		vd55g0_apply_reset(sensor);
+
+	ret = vd55g0_wait_state(sensor, VD55G0_SYSTEM_FSM_READY_TO_BOOT,
+				VD55G0_TIMEOUT_MS);
+	if (ret) {
+		dev_err(&client->dev, "sensor reset failed %d\n", ret);
+		goto disable_clock;
+	}
+
+	ret = vd55g0_detect(sensor);
+	if (ret) {
+		dev_err(&client->dev, "sensor detect failed %d\n", ret);
+		goto disable_clock;
+	}
+
+	ret = vd55g0_patch(sensor);
+	if (ret) {
+		dev_err(&client->dev, "sensor patch failed %d\n", ret);
+		goto disable_clock;
+	}
+
+	ret = vd55g0_boot(sensor);
+	if (ret) {
+		dev_err(&client->dev, "sensor boot failed %d\n", ret);
+		goto disable_clock;
+	}
+
+	ret = vd55g0_configure(sensor);
+	if (ret) {
+		dev_err(&client->dev, "sensor configuration failed %d\n", ret);
+		goto disable_clock;
+	}
+
+	return 0;
+
+disable_clock:
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	clk_disable_unprepare(sensor->xclk);
+disable_bulk:
+	regulator_bulk_disable(sensor->nb_supplies, sensor->supplies);
+
+	return ret;
+}
+
+static int vd55g0_power_off(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct vd55g0_dev *sensor = to_vd55g0_dev(sd);
+
+	/* Hold the sensor in reset while its rails are off, as vd55g1 does */
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	clk_disable_unprepare(sensor->xclk);
+	regulator_bulk_disable(sensor->nb_supplies, sensor->supplies);
+	return 0;
+}
+
+static int vd55g0_parse_dt_gpios_array(struct vd55g0_dev *sensor,
+				       char *prop_name, u32 *array, int *nb)
+{
+	struct i2c_client *client = sensor->i2c_client;
+	unsigned int i;
+	int ret;
+
+	*nb = device_property_count_u32(&client->dev, prop_name);
+	if (*nb == -EINVAL) {
+		/* Property not found */
+		*nb = 0;
+		return 0;
+	}
+	if (*nb < 0)
+		return *nb;
+	if (*nb > VD55G0_NB_GPIOS) {
+		dev_err(&client->dev, "%s lists %d GPIOs, the sensor has %d\n",
+			prop_name, *nb, VD55G0_NB_GPIOS);
+		return -EINVAL;
+	}
+
+	ret = device_property_read_u32_array(&client->dev, prop_name, array,
+					     *nb);
+	if (ret) {
+		dev_err(&client->dev, "Failed to read %s prop\n", prop_name);
+		return ret;
+	}
+
+	for (i = 0; i < *nb;  i++) {
+		if (array[i] >= VD55G0_NB_GPIOS) {
+			dev_err(&client->dev, "invalid GPIO %d for leds\n",
+				array[i]);
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
+static int vd55g0_parse_dt_gpios(struct vd55g0_dev *sensor)
+{
+	int nb_gpios_leds;
+	int ret;
+
+	memset(sensor->leds, ~0, sizeof(sensor->leds));
+
+	ret = vd55g0_parse_dt_gpios_array(sensor, "st,leds", sensor->leds,
+					  &nb_gpios_leds);
+	if (ret)
+		return ret;
+
+	sensor->nb_leds = nb_gpios_leds;
+
+	return 0;
+}
+
+static int vd55g0_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct fwnode_handle *handle;
+	struct vd55g0_dev *sensor;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->analog_gain = 0;
+	sensor->digital_gain = 256;
+
+	sensor->i2c_client = client;
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sensor->regmap))
+		return dev_err_probe(&client->dev, PTR_ERR(sensor->regmap),
+				     "failed to init CCI\n");
+	sensor->streaming = false;
+	/* Must match what vd55g0_init_state() puts in the subdev state */
+	sensor->code = VD55G0_MEDIA_BUS_FMT_DEF;
+	sensor->manual_expo = VD55G0_EXPO_DEF;
+	sensor->vflip = false;
+	sensor->hflip = false;
+	sensor->flash_en = false;
+	/* Written at every stream start, so it must match the control default */
+	sensor->exposure_target = VD55G0_EXPO_TARGET_DEF;
+	sensor->cold_start.expo = 0x32;
+	sensor->cold_start.digital_gain = 256;
+	sensor->cold_start.analog_gain = 0;
+
+	sensor->current_mode = &vd55g0_mode_data[VD55G0_DEFAULT_MODE];
+
+	handle = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0, 0);
+
+	sensor->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset_gpio)) {
+		ret = dev_err_probe(dev, PTR_ERR(sensor->reset_gpio),
+				    "Failed to get reset gpio\n");
+		goto error_put_handle;
+	}
+
+	ret = vd55g0_parse_dt_gpios(sensor);
+	if (ret) {
+		dev_err(dev, "Failed to get gpios\n");
+		goto error_put_handle;
+	}
+
+	ret = vd55g0_tx_from_ep(sensor, handle);
+	if (ret) {
+		dev_err_probe(dev, ret, "Failed to parse endpoint\n");
+		goto error_put_handle;
+	}
+	fwnode_handle_put(handle);
+
+	sensor->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sensor->xclk))
+		return dev_err_probe(dev, PTR_ERR(sensor->xclk),
+				     "failed to get xclk\n");
+
+	sensor->clk_freq = clk_get_rate(sensor->xclk);
+	ret = vd55g0_prepare_clock_tree(sensor);
+	if (ret)
+		return ret;
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &vd55g0_subdev_ops);
+	sensor->sd.internal_ops = &vd55g0_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	sensor->sd.entity.ops = &vd55g0_subdev_entity_ops;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = vd55g0_get_regulators(sensor);
+	if (ret)
+		return dev_err_probe(&client->dev, ret,
+				     "failed to get regulators\n");
+
+	/* Power on once to check that the sensor answers */
+	ret = vd55g0_power_on(dev);
+	if (ret)
+		return ret;
+
+	mutex_init(&sensor->lock);
+
+	ret = vd55g0_update_vblank(sensor, VD55G0_FRAME_LENGTH_DEF -
+				   sensor->current_mode->crop.height);
+	if (ret)
+		goto error_power_off;
+
+	ret = vd55g0_init_controls(sensor);
+	if (ret) {
+		dev_err(&client->dev, "controls initialization failed %d\n",
+			ret);
+		goto error_power_off;
+	}
+
+	sensor->sd.state_lock = &sensor->lock;
+
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret) {
+		dev_err(&client->dev, "pads init failed %d\n", ret);
+		goto error_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret) {
+		dev_err(&client->dev, "subdev init error %d\n", ret);
+		goto error_media_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev(&sensor->sd);
+	if (ret) {
+		dev_err(&client->dev, "async subdev register failed %d\n", ret);
+		goto error_pm_runtime;
+	}
+
+	/* Runtime PM may power the sensor down only from here on */
+	pm_runtime_set_autosuspend_delay(&client->dev, 1000);
+	pm_runtime_use_autosuspend(&client->dev);
+	pm_runtime_idle(dev);
+
+	dev_dbg(&client->dev, "vd55g0 probe successfully\n");
+
+	return 0;
+
+error_put_handle:
+	fwnode_handle_put(handle);
+
+	return ret;
+
+error_pm_runtime:
+	pm_runtime_disable(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+error_media_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+error_handler_free:
+	v4l2_ctrl_handler_free(sensor->sd.ctrl_handler);
+error_power_off:
+	mutex_destroy(&sensor->lock);
+	vd55g0_power_off(dev);
+
+	return ret;
+}
+
+static void vd55g0_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct vd55g0_dev *sensor = to_vd55g0_dev(sd);
+
+	v4l2_async_unregister_subdev(&sensor->sd);
+	v4l2_subdev_cleanup(&sensor->sd);
+	media_entity_cleanup(&sensor->sd.entity);
+	v4l2_ctrl_handler_free(sensor->sd.ctrl_handler);
+	mutex_destroy(&sensor->lock);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		vd55g0_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+	pm_runtime_dont_use_autosuspend(&client->dev);
+}
+
+static const struct of_device_id vd55g0_dt_ids[] = {
+	{ .compatible = "st,vd55g0" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, vd55g0_dt_ids);
+
+static const struct dev_pm_ops vd55g0_pm_ops = {
+	SET_RUNTIME_PM_OPS(vd55g0_power_off, vd55g0_power_on, NULL)
+};
+
+static struct i2c_driver vd55g0_i2c_driver = {
+	.driver = {
+		.name  = "vd55g0",
+		.of_match_table = vd55g0_dt_ids,
+		.acpi_match_table = vd55g0_acpi_ids,
+		.pm = &vd55g0_pm_ops,
+	},
+	.probe = vd55g0_probe,
+	.remove = vd55g0_remove,
+};
+
+module_i2c_driver(vd55g0_i2c_driver);
+
