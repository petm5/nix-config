From 89fcc179f917bfdf56dc7883cd90136e47a106e0 Mon Sep 17 00:00:00 2001
From: Peter Marshall <pm@petermarshall.ca>
Date: Sun, 25 Oct 2026 13:15:14 -0400
Subject: [PATCH 15/20]  media: i2c: st-vd55g: Limit flash duty cycle

Limit the exposure to 50% duty cycle when the flash is active to avoid
tripping its overcurrent protection.
---
 drivers/media/i2c/vd55g0.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/media/i2c/vd55g0.c b/drivers/media/i2c/vd55g0.c
index 9df8292affe5..8dd762feb705 100644
--- a/drivers/media/i2c/vd55g0.c
+++ b/drivers/media/i2c/vd55g0.c
@@ -1769,6 +1769,9 @@ static int vd55g0_set_fmt(struct v4l2_subdev *sd,
 		return ret;
 	/* Max exposure changes with vblank */
 	expo_max = sensor->frame_length - VD55G0_EXPO_MAX_TERM;
+	if (sensor->flash_en) {
+		expo_max /= 2;
+	}
 	ret = __v4l2_ctrl_modify_range(sensor->expo_ctrl, 0, expo_max, 1,
 				       VD55G0_EXPO_DEF);
 	if (ret)
-- 
2.56.0

